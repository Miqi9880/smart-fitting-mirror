# Copy this file to .env locally, then fill in your own values.
# .env is ignored by Git. Never commit, screenshot, or share the real values.
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# Paths may be absolute or relative to this repository root.
# Keep test images and generated results OUTSIDE the repository.
VOLC_TRYON_MODEL_IMAGE=../private/tryon-test-assets/synthetic-full-body-model-v1.png
VOLC_TRYON_GARMENT_IMAGE=backend/assets/upper_blue.png
VOLC_TRYON_OUTPUT_DIR=../private/tryon-results
# Stores only task ID, timestamps, status, and result path outside Git; no keys.
VOLC_TRYON_STATE_FILE=../private/volc-tryon-last-task.json

# A non-personal identifier used in the API result metadata for this local POC.
VOLC_TRYON_PRODUCER_ID=smart-fitting-mirror-poc
