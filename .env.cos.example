# Copy this file to .env.cos locally, then fill in the CAM sub-user keys.
# .env.cos is ignored by Git. Never commit, screenshot, or share real keys.
COS_SECRET_ID=
COS_SECRET_KEY=

# Private COS bucket used only for short-lived virtual try-on inputs.
COS_REGION=ap-guangzhou
COS_BUCKET=smartmirror-tryon-01-1514304052
COS_INPUT_PREFIX=tryon-input/

# Aidge receives a signed HTTPS URL, not public-bucket access.
# 1800 seconds gives the provider 30 minutes to fetch each input image.
COS_PRESIGN_EXPIRES_SECONDS=1800

# Leave blank for the current permanent CAM sub-user key.
# This is reserved for a future STS temporary credential.
COS_SESSION_TOKEN=
