# Copy this file to .env.aliyun locally, then fill in values saved from RAM.
# .env.aliyun is ignored by Git. Never commit, screenshot, or share real keys.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Aidge virtual try-on uses the China (Beijing) endpoint.
ALIYUN_AIDGE_ENDPOINT=aidge.cn-beijing.aliyuncs.com
ALIYUN_AIDGE_REGION=cn-beijing
ALIYUN_AIDGE_API_VERSION=2026-04-28

# These URL fields are used by the standalone smoke script. The formal
# --provider aidge-cos backend ignores them and creates fresh COS signed URLs
# in memory for each job.
ALIYUN_TRYON_MODEL_IMAGE_URL=
ALIYUN_TRYON_GARMENT_IMAGE_URL=
ALIYUN_TRYON_CLOTH_TYPE=tops
ALIYUN_TRYON_RESOLUTION=1K

# Generated results stay outside this Git repository.
ALIYUN_TRYON_OUTPUT_DIR=../private/aliyun-tryon-results
# Stores only task ID, timestamps, status, and result path outside Git; no keys.
ALIYUN_TRYON_STATE_FILE=../private/aliyun-tryon-last-task.json
