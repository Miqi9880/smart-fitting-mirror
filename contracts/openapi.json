              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "建议等待的秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
