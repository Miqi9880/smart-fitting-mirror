  "components": {
    "securitySchemes": {
      "SessionToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "本项目游客会话令牌，不是供应商密钥"
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "session_token": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "session_id",
          "session_token",
          "expires_at"
        ]
      },
      "PreviewImage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left_shoulder": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "right_shoulder": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "left_hip": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "right_hip": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "left_shoulder",
              "right_shoulder",
              "left_hip",
              "right_hip"
            ],
            "nullable": true
          },
          "attachment_anchors": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ]
            },
            "description": "Category-specific source coordinates. lower_body: both hips/knees/ankles; headwear: ears; dress/skirt/shorts: hips and hem. Hem is a garment edge control, not an inferred anatomical landmark. Dress additionally requires torso anchors; other non-upper categories use null torso anchors."
          },
          "hem_ratio": {
            "type": "number",
            "nullable": true,
            "minimum": 0.1,
            "maximum": 2,
            "description": "Required for dress/skirt/shorts previews: 0..1 interpolates current hip to knee; 1..2 knee to ankle. Shorts must be <=1. Garment-specific initial calibration, not body measurement."
          }
        },
        "required": [
          "url",
          "width",
          "height",
          "anchors"
        ],
        "description": "Upper body uses torso anchors; dress adds hips/hem and hem_ratio. Skirt/shorts use hips/hem and hem_ratio with null torso anchors. Selection excludes dress with upper/lower garments and allows only one of pants/skirt/shorts. Headwear is independent. Garment and asset categories must agree."
      },
