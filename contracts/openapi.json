{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Fitting Mirror Course API",
    "version": "0.3.0",
    "description": "设备未到位阶段的接口合同，尚无可运行服务。首版仅上衣。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "SessionToken": []
    }
  ],
  "paths": {
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "创建临时游客会话",
        "responses": {
          "201": {
            "description": "会话已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "429": {
            "description": "限流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "建议等待的秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "服务不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
